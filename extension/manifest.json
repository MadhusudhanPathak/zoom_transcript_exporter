{
  "manifest_version": 3,
  "name": "Zoom Transcript Exporter",
  "version": "1.0.0",
  "description": "Export the transcript panel of a Zoom recording you can already view as a text file.",
  "homepage_url": "https://github.com/MadhusudhanPathak/zoom_transcript_exporter",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export transcript",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["activeTab", "scripting"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
